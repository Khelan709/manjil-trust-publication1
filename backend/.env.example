PORT=5000
NODE_ENV=development

# MongoDB connection (see /database/docker-compose.yml for a local instance, or use MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/manjil_publication

# Secret used to sign admin login tokens. REQUIRED in production: use a long random string
# (generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-in-production

# First admin account. Created automatically on startup if NO admin exists yet.
# (After the first login you can add more admins in the admin panel and remove these two lines.)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# Origin(s) allowed to call the API from a different domain (comma separated). Not needed when the
# backend also serves the website (single deployment).
CORS_ORIGIN=http://localhost:5173

# Serve the built website (frontend/dist) from this server. "true" in production deployments.
SERVE_FRONTEND=false

# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx…) so client IPs are correct.
TRUST_PROXY=0
